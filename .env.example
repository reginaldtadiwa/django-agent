# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Any Gemini model LangChain's ChatGoogleGenerativeAI supports
GEMINI_MODEL=gemini-2.5-flash

# How many Coder->Tester->Reviewer revision loops before giving up
MAX_ITERATIONS=3

# Where the generated, runnable Django project is written
PROJECT_OUTPUT_DIR=./generated_project
